{
  "manifest_version": 3,
  "name": "PromptLint — AI Prompt Linter",
  "version": "1.2.0",
  "minimum_chrome_version": "105",
  "description": "Underlines weak AI prompts as you type in ChatGPT, Claude, Gemini & Perplexity. Live score + 1-click restructure. 100% local.",
  "homepage_url": "https://www.buildwithsiddesh.com/",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PromptLint",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open or close the PromptLint panel"
    },
    "restructure-prompt": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Restructure the current prompt and insert it"
    },
    "open-library": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open the prompt library"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*"
      ],
      "js": [
        "shared/tokenizer.js",
        "shared/storage.js",
        "shared/library.js",
        "shared/stats.js",
        "shared/ui-kit.js",
        "content/rules.js",
        "content/restructure.js",
        "content/quickfix.js",
        "content/highlighter.js",
        "content/badge.js",
        "content/panel.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/gemini.js",
        "content/adapters/perplexity.js",
        "content/adapters/generic.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
